# Copy to deploy/market-store/.env (git-ignored) and replace the placeholder password.
# Generate a random password in PowerShell:
#   -join ((48..57 + 65..90 + 97..122) | Get-Random -Count 32 | ForEach-Object { [char]$_ })
MARKET_STORE_USER=market_store
MARKET_STORE_PASSWORD=CHANGE_ME_generate_a_random_password
MARKET_STORE_DB=market_store
MARKET_STORE_PORT=55432
