FROM python:3.12-slim@sha256:423ed6ab25b1921a477529254bfeeabf5855151dc2c3141699a1bfc852199fbf AS provenance-validation

ARG TRADE_RL_GIT_COMMIT
ARG TRADE_RL_GIT_DIRTY
ARG TRADE_RL_SOURCE_TREE_DIGEST
ARG TRADE_RL_LOCKFILE_DIGEST
ARG TRADE_RL_RUNTIME_MANIFEST_DIGEST
RUN printf '%s\n' "${TRADE_RL_GIT_COMMIT}" | grep -Eq '^[0-9a-f]{40}$' \
    && printf '%s\n' "${TRADE_RL_SOURCE_TREE_DIGEST}" | grep -Eq '^[0-9a-f]{64}$' \
    && printf '%s\n' "${TRADE_RL_LOCKFILE_DIGEST}" | grep -Eq '^[0-9a-f]{64}$' \
    && printf '%s\n' "${TRADE_RL_RUNTIME_MANIFEST_DIGEST}" | grep -Eq '^$|^[0-9a-f]{64}$' \
    && case "${TRADE_RL_GIT_DIRTY}" in "true"|"false") ;; *) exit 1 ;; esac \
    && printf '%s:%s:%s:%s:%s\n' \
        "${TRADE_RL_GIT_COMMIT}" \
        "${TRADE_RL_GIT_DIRTY}" \
        "${TRADE_RL_SOURCE_TREE_DIGEST}" \
        "${TRADE_RL_LOCKFILE_DIGEST}" \
        "${TRADE_RL_RUNTIME_MANIFEST_DIGEST}" \
        > /provenance.valid

FROM python:3.12-slim@sha256:423ed6ab25b1921a477529254bfeeabf5855151dc2c3141699a1bfc852199fbf AS training-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TRADE_RL_METADATA_MODE=frozen_snapshot \
    TRADE_RL_RESEARCH_PHASE=develop \
    TRADE_RL_MARKET_DATA_CACHE_ROOT=/workspace/market-data/binance-vision \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/trade-rl-venv \
    PATH="/opt/trade-rl-venv/bin:${PATH}"

COPY uv.toml /tmp/trade-rl-uv.toml
RUN groupadd --system trainer \
    && useradd --system --gid trainer --create-home trainer \
    && UV_VERSION="$(python -c 'import tomllib; print(tomllib.load(open("/tmp/trade-rl-uv.toml", "rb"))["required-version"].removeprefix("=="))')" \
    && pip install --no-cache-dir "uv==${UV_VERSION}" \
    && test "$(uv --version)" = "uv ${UV_VERSION}" \
    && rm /tmp/trade-rl-uv.toml

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends build-essential

WORKDIR /workspace
COPY pyproject.toml uv.lock uv.toml README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --extra train-sb3 --extra postgres --no-dev --no-install-project \
    && mkdir -p \
        /workspace/var/runs \
        /workspace/var/cache/teacher-artifacts \
        /workspace/market-data/binance-vision \
    && chown trainer:trainer /workspace/var \
        /workspace/var/runs \
        /workspace/var/cache \
        /workspace/var/cache/teacher-artifacts \
        /workspace/market-data \
        /workspace/market-data/binance-vision

COPY --chown=trainer:trainer trade_rl ./trade_rl
COPY --chown=trainer:trainer examples ./examples
COPY --chown=trainer:trainer scripts ./scripts
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --extra train-sb3 --extra postgres --no-dev \
    && python -c 'import torch; compiled = torch.compile(lambda value: value + 1); assert compiled(torch.ones(1)).item() == 2.0'

ARG TRADE_RL_GIT_COMMIT
ARG TRADE_RL_GIT_DIRTY
ARG TRADE_RL_SOURCE_TREE_DIGEST
ARG TRADE_RL_LOCKFILE_DIGEST
ARG TRADE_RL_RUNTIME_MANIFEST_DIGEST
COPY --from=provenance-validation /provenance.valid /provenance.valid

ENV TRADE_RL_GIT_COMMIT=${TRADE_RL_GIT_COMMIT} \
    TRADE_RL_GIT_DIRTY=${TRADE_RL_GIT_DIRTY} \
    TRADE_RL_SOURCE_TREE_DIGEST=${TRADE_RL_SOURCE_TREE_DIGEST} \
    TRADE_RL_LOCKFILE_DIGEST=${TRADE_RL_LOCKFILE_DIGEST} \
    TRADE_RL_RUNTIME_MANIFEST_DIGEST=${TRADE_RL_RUNTIME_MANIFEST_DIGEST}

LABEL org.opencontainers.image.revision=${TRADE_RL_GIT_COMMIT} \
    io.trade-rl.source-tree-digest=${TRADE_RL_SOURCE_TREE_DIGEST} \
    io.trade-rl.lockfile-digest=${TRADE_RL_LOCKFILE_DIGEST} \
    io.trade-rl.runtime-manifest-digest=${TRADE_RL_RUNTIME_MANIFEST_DIGEST}

RUN test "$(sha256sum uv.lock | cut -d' ' -f1)" = "${TRADE_RL_LOCKFILE_DIGEST}" \
    && test "$(python -c 'from trade_rl.artifacts.provenance import source_tree_digest; print(source_tree_digest("/workspace"))')" = "${TRADE_RL_SOURCE_TREE_DIGEST}"

USER trainer
RUN test "$(id -u)" -ne 0 \
    && test -w /workspace/var \
    && test -w /workspace/var/runs \
    && test -w /workspace/var/cache/teacher-artifacts \
    && test -w /workspace/market-data/binance-vision \
    && test -r /workspace/trade_rl/__init__.py \
    && test -r /workspace/examples/binance-multitimeframe/training_bootstrap.py \
    && test "$(cat /provenance.valid)" \
        = "${TRADE_RL_GIT_COMMIT}:${TRADE_RL_GIT_DIRTY}:${TRADE_RL_SOURCE_TREE_DIGEST}:${TRADE_RL_LOCKFILE_DIGEST}:${TRADE_RL_RUNTIME_MANIFEST_DIGEST}"

CMD ["python", "examples/binance-multitimeframe/full_run_entrypoint.py"]

FROM training-runtime AS studio-runtime

USER root
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --extra train-sb3 --extra postgres --extra studio --no-dev
USER trainer

CMD ["trade-rl", "studio", "start", "--project-root", "/workspace", "--host", "0.0.0.0", "--port", "8765", "--allow-container-bind"]
